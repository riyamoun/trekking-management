# Flask
FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret

# Database (SQLite — created programmatically)
DATABASE_URL=sqlite:///instance/trek.db

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Notifications — leave blank to use local mock fallback (writes to reports/notifications.log)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@trekmanage.local
ADMIN_EMAIL=admin@trekmanage.local

# Google Chat / webhook (optional; mocked when empty)
WEBHOOK_URL=

# Demo admin (seeded programmatically)
ADMIN_EMAIL_SEED=admin@trekmanage.local
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=System Admin
