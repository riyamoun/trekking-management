# Flask
FLASK_ENV=development
FLASK_DEBUG=0
PORT=3847

# REQUIRED for predictable local admin login (otherwise a random password is
# written once to instance/BOOTSTRAP_ADMIN.txt — never commit that file)
SECRET_KEY=
JWT_SECRET_KEY=
ADMIN_EMAIL_SEED=admin@trekmanage.local
ADMIN_PASSWORD=
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@trekmanage.local

# Database (SQLite — created programmatically)
DATABASE_URL=sqlite:///instance/trek.db

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Lab / viva fixtures (OFF for published deploys)
SEED_DEMO_DATA=false
SHOW_LAB_HINTS=false
DEMO_STAFF_PASSWORD=
DEMO_USER_PASSWORD=

# CORS — leave empty for same-origin only; comma-separated allowlist if needed
CORS_ORIGINS=

# Notifications — blank = local mock fallback
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@trekmanage.local
WEBHOOK_URL=
