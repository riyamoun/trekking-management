# Flask — copy to .env for local / viva (never commit .env)
FLASK_ENV=development
FLASK_DEBUG=0
PORT=3847

# Signing keys — leave blank locally to auto-generate into instance/
SECRET_KEY=
JWT_SECRET_KEY=

# Admin (seeded on first boot). For viva, set a known password here
# or let scripts/start-local.py fill lab defaults when creating .env.
ADMIN_EMAIL_SEED=admin@trekmanage.local
ADMIN_PASSWORD=
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@trekmanage.local

# Database (SQLite — created programmatically under instance/)
DATABASE_URL=sqlite:///instance/trek.db

# Redis (cache + Celery broker)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Lab / viva fixtures — set true on your laptop for instructor demo
SEED_DEMO_DATA=true
SHOW_LAB_HINTS=true
DEMO_STAFF_PASSWORD=
DEMO_USER_PASSWORD=

# CORS — leave empty for same-origin SPA
CORS_ORIGINS=

# Notifications — blank = local mock (reports/notifications.log)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@trekmanage.local
WEBHOOK_URL=
